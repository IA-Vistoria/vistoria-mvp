# Copie para .env e ajuste os valores:
#   copy .env.example .env

# Obrigatório — mínimo 32 bytes
JWT_SECRET=segredo-local-docker-com-pelo-menos-32-bytes

# Convite para cadastro de engenheiro
ENGINEER_REGISTRATION_CODE=convite-dev

# Integração com a IA (container inference no mesmo compose)
APP_IA_PROVIDER=vlm
VLM_URL=http://inference:8001
# Mesma chave usada como API_KEY do container inference
VLM_API_KEY=dev-local-chave-forte-123

# Inference (opcional — defaults do compose)
# MODEL_DEVICE=cuda
# Sem GPU NVIDIA: use MODEL_DEVICE=cpu e remova "gpus: all" do docker-compose.yml
# MODEL_ID=Qwen/Qwen3-VL-2B-Instruct
# REQUIRE_API_KEY=true

CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api
