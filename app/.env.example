# Copie para .env e ajuste os valores. Nunca versione o .env real.
#   copy .env.example .env

# Obrigatório — mínimo 32 bytes; use outro valor fora do desenvolvimento local.
JWT_SECRET=troque-este-segredo-local-com-pelo-menos-32-bytes
ENGINEER_REGISTRATION_CODE=

# A integração principal usa OCI Generative AI com Gemini via SDK oficial.
# config_file: desenvolvimento local; instance_principal: workload na OCI.
APP_IA_PROVIDER=oci
OCI_AUTH_MODE=config_file
OCI_REGION=sa-saopaulo-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..substitua-pelo-compartment
OCI_GENAI_MODEL_ID=google.gemini-2.5-flash
OCI_CONFIG_PROFILE=DEFAULT
OCI_CONFIG_FILE=/home/spring/.oci/config

# Caminho do host montado somente pelo override docker-compose.oci-config.yml.
# Windows: C:/Users/seu-usuario/.oci
# Linux/macOS: /home/seu-usuario/.oci
OCI_CONFIG_DIR=C:/Users/seu-usuario/.oci

# Timeouts e retry seguros; não exceda três tentativas.
OCI_GENAI_CONNECT_TIMEOUT_MS=5000
OCI_GENAI_READ_TIMEOUT_MS=30000
OCI_GENAI_MAX_ATTEMPTS=3
OCI_GENAI_RETRY_DELAY_MS=500

# Provider VLM legado, apenas quando APP_IA_PROVIDER=vlm e o profile Docker vlm for ativado.
VLM_URL=http://inference:8001
VLM_API_KEY=substitua-por-uma-chave-local
MODEL_DEVICE=cuda
MODEL_ID=Qwen/Qwen3-VL-2B-Instruct
REQUIRE_API_KEY=true

CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api
