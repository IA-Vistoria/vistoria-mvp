{
  "service": "MVP IA Vistoria",
  "version": "0.1.0",
  "base_url": "https://{HOST_PUBLICO_OU_IP}:8001",
  "env_for_backend": "VLM_URL=https://{HOST_PUBLICO}\nVLM_API_KEY={mesma_API_KEY_do_servico}",
  "auth": {
    "type": "api_key",
    "headers_accepted": ["X-API-Key", "Authorization: Bearer <key>"],
    "public_paths": ["/health", "/docs", "/openapi.json", "/redoc", "/static"],
    "protected_paths": ["/analyze"],
    "notes": "Em produção REQUIRE_API_KEY=true e API_KEY forte. /health fica público para probes."
  },
  "language_rule": "A IA nunca afirma diagnóstico técnico definitivo. Só relata indícios visuais (ex.: possible_moisture, apparent_crack).",

  "endpoints": {
    "GET /health": {
      "description": "Indica se o modelo está carregado e pronto.",
      "success_http_status": 200,
      "not_ready_http_status": 503,
      "response_schema": {
        "status": {
          "type": "string",
          "enum": ["ok", "model_not_ready"]
        },
        "model_loaded": { "type": "boolean" },
        "model_id": { "type": "string" },
        "device": {
          "type": "string",
          "enum": ["cuda", "cpu"]
        }
      }
    },
    "POST /analyze": {
      "description": "Recebe uma imagem e devolve JSON estruturado de análise visual.",
      "content_type": "multipart/form-data",
      "form_field": "image",
      "accepted_mime_types": [
        "image/jpeg",
        "image/jpg",
        "image/png",
        "image/webp",
        "image/bmp"
      ],
      "max_image_size_mb": 15,
      "success_http_status": 200,
      "error_http_statuses": [400, 500, 503]
    }
  },

  "analyze_success_response_schema": {
    "analysis_id": {
      "type": "string",
      "format": "uuid",
      "required": true,
      "description": "ID gerado a cada análise."
    },
    "image_quality": {
      "type": "object",
      "required": true,
      "fields": {
        "usable": {
          "type": "boolean",
          "description": "true = imagem processável; false = rejeitada na validação (areas vem vazio)."
        },
        "issues": {
          "type": "array",
          "items": "string",
          "description": "Lista de problemas de qualidade/validação. Vazia quando usable=true e sem alertas."
        }
      }
    },
    "areas": {
      "type": "array",
      "required": true,
      "description": "Lista de achados visuais. Pode ser [].",
      "item_fields": {
        "area": {
          "type": "string",
          "recommended_values": ["parede", "rodape", "outro"],
          "description": "Região observada. Preferir um valor único."
        },
        "issue_type": {
          "type": "string",
          "enum": [
            "possible_moisture",
            "apparent_mold",
            "apparent_crack",
            "peeling",
            "stain",
            "dirt",
            "bubble",
            "scratch",
            "hole",
            "wear",
            "broken_piece",
            "detachment",
            "missing_part",
            "insufficient_evidence",
            "other_visual_issue"
          ]
        },
        "description": {
          "type": "string",
          "description": "Descrição visual sem diagnóstico definitivo."
        },
        "evidence": {
          "type": "string",
          "description": "O que na imagem sustenta a observação."
        },
        "severity": {
          "type": "string",
          "enum": ["baixa", "media", "alta"]
        },
        "confidence": {
          "type": "string",
          "enum": ["baixa", "media", "alta"]
        },
        "recommendation": {
          "type": "string",
          "description": "Sugestão cautelosa, tipicamente avaliação presencial."
        },
        "location": {
          "type": ["string", "null"],
          "description": "Localização aproximada na imagem, se identificável."
        }
      }
    },
    "overall_summary": {
      "type": "string",
      "required": true,
      "description": "Resumo em português do que foi observado."
    },
    "limitations": {
      "type": "array",
      "items": "string",
      "required": true,
      "description": "Limitações da análise. Sempre incluir aviso de que não substitui vistoria presencial."
    }
  },

  "image_quality_issues_possible_values": [
    "empty_file",
    "file_too_large_max_15mb",
    "unsupported_mime_type:{mime}",
    "not_a_decodable_image",
    "unsupported_or_corrupt_image",
    "unsupported_image_format",
    "image_too_small",
    "model_output_not_json",
    "schema_mapping_failed"
  ],

  "issue_type_meanings": {
    "possible_moisture": "Sinais visuais compatíveis com possível umidade.",
    "apparent_mold": "Manchas/textura aparentes compatíveis com mofo.",
    "apparent_crack": "Fissura/rachadura aparente na superfície.",
    "peeling": "Descascamento de tinta/revestimento.",
    "stain": "Mancha visual sem classificação mais específica.",
    "dirt": "Sujeira aparente.",
    "bubble": "Bolhas aparentes na superfície.",
    "scratch": "Riscos aparentes.",
    "hole": "Furos aparentes.",
    "wear": "Desgaste aparente.",
    "broken_piece": "Peça quebrada/trincada aparente.",
    "detachment": "Descolamento aparente.",
    "missing_part": "Parte faltante aparente.",
    "insufficient_evidence": "Evidência visual insuficiente para afirmar problema.",
    "other_visual_issue": "Outro problema visual identificável."
  },

  "all_possible_outcomes": {
    "A_health_ok": {
      "http_status": 200,
      "endpoint": "GET /health",
      "when": "Modelo carregado e pronto.",
      "body": {
        "status": "ok",
        "model_loaded": true,
        "model_id": "Qwen/Qwen3-VL-2B-Instruct",
        "device": "cuda"
      }
    },

    "B_health_not_ready": {
      "http_status": 503,
      "endpoint": "GET /health",
      "when": "Serviço no ar, mas modelo ainda não carregou ou falhou no load.",
      "body": {
        "status": "model_not_ready",
        "model_loaded": false,
        "model_id": "Qwen/Qwen3-VL-2B-Instruct",
        "device": "cuda"
      }
    },

