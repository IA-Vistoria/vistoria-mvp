    "D_analyze_no_findings": {
      "http_status": 200,
      "endpoint": "POST /analyze",
      "when": "Imagem válida sem problemas visuais evidentes.",
      "body": {
        "analysis_id": "b507f584-e6b5-4543-9eb2-255c4324728a",
        "image_quality": {
          "usable": true,
          "issues": []
        },
        "areas": [],
        "overall_summary": "Ambiente com paredes e rodapés sem sinais visuais evidentes de manchas, mofo, rachaduras ou desgaste.",
        "limitations": [
          "Análise baseada apenas em imagem; não substitui vistoria técnica presencial."
        ]
      }
    },

    "E_analyze_insufficient_evidence": {
      "http_status": 200,
      "endpoint": "POST /analyze",
      "when": "Imagem válida, mas evidência visual fraca/ambígua.",
      "body": {
        "analysis_id": "689c0fd6-f60b-45ab-b155-2d3475c5c499",
        "image_quality": {
          "usable": true,
          "issues": []
        },
