# --- Modelo ---
MODEL_ID=Qwen/Qwen3-VL-2B-Instruct
MODEL_DEVICE=cuda
MAX_IMAGE_SIZE_MB=15
PORT=8001
# Optional: 4-bit load on CUDA to reduce VRAM (true/false)
LOAD_IN_4BIT=false
# Max new tokens for model generation
MAX_NEW_TOKENS=1024

# --- Segurança (SaaS: só o backend conhece esta chave) ---
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# NUNCA coloque no frontend / browser.
API_KEY=troque-esta-chave-por-um-segredo-forte
# true = falha fechado (obrigatório em Oracle / produção)
REQUIRE_API_KEY=true

# --- CORS ---
# Em SaaS a VLM é server-to-server (backend → VLM). * é ok nesse caso.
# Só restrinja se o browser chamar a VLM diretamente (não recomendado).
CORS_ORIGINS=*

# --- Cloudflare Tunnel (opcional) ---
# docker compose --profile tunnel up -d
# TUNNEL_TOKEN=eyJ...token_do_zero_trust...
